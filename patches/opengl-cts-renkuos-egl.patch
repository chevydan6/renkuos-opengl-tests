+#!/bin/sh
+# SPDX-License-Identifier: MIT
+set -eu
+bundle_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+# Mesa shader-cache workers can stall CTS shutdown on this Haiku build.
+# Set MESA_SHADER_CACHE_DISABLE=false explicitly to test the cache.
+if [ "${MESA_SHADER_CACHE_DISABLE+x}" != x ]; then
+    MESA_SHADER_CACHE_DISABLE=true
+    export MESA_SHADER_CACHE_DISABLE
+fi
+archive_option="--deqp-archive-dir=$bundle_dir"
+reset_option=--deqp-terminate-on-device-lost=disable
+surface_option=--deqp-surface-type=pbuffer
+width_option=--deqp-surface-width=256
+height_option=--deqp-surface-height=256
+native_factory=no
+fbo_surface=no
+context_arg=no
+surface_arg=no
+for argument do
+    if [ "$context_arg" = yes ]; then
+        [ "$argument" = haiku ] && native_factory=yes
+        context_arg=no
+        continue
+    fi
+    if [ "$surface_arg" = yes ]; then
+        [ "$argument" = fbo ] && fbo_surface=yes
+        surface_arg=no
+        continue
+    fi
+    case "$argument" in
+        --deqp-archive-dir|--deqp-archive-dir=*) archive_option= ;;
+        --deqp-terminate-on-device-lost|--deqp-terminate-on-device-lost=*) reset_option= ;;
+        --deqp-surface-type=fbo) surface_option=; fbo_surface=yes ;;
+        --deqp-surface-type=*) surface_option= ;;
+        --deqp-surface-type) surface_option=; surface_arg=yes ;;
+        --deqp-surface-width|--deqp-surface-width=*) width_option= ;;
+        --deqp-surface-height|--deqp-surface-height=*) height_option= ;;
+        --deqp-gl-context-type=haiku) native_factory=yes ;;
+        --deqp-gl-context-type) context_arg=yes ;;
+    esac
+done
+[ "$native_factory" = yes ] && surface_option=
+[ "$fbo_surface" = yes ] || { width_option=; height_option=; }
+[ -n "$archive_option" ] && set -- "$archive_option" "$@"
+[ -n "$reset_option" ] && set -- "$reset_option" "$@"
+[ -n "$surface_option" ] && set -- "$surface_option" "$@"
+[ -n "$width_option" ] && set -- "$width_option" "$@"
+[ -n "$height_option" ] && set -- "$height_option" "$@"
+exec "$bundle_dir/glcts" "$@"
