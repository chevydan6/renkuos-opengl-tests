+
+@pytest.mark.skipif(os.name != 'posix', reason='Requires POSIX process groups')
+@pytest.mark.parametrize('stage', ['terminate', 'getpgid', 'killpg'])
+def test_timeout_process_exits_during_cleanup(stage):
+    """A process disappearing during timeout cleanup is still a timeout."""
+    proc = mock.Mock()
+    proc.pid = 123
+    proc.poll.return_value = None
+    proc.communicate.side_effect = [subprocess.TimeoutExpired('test', 1),
+                                    ('partial output', '')]
+    missing = ProcessLookupError(base.errno.ESRCH, 'process exited')
+    if stage == 'terminate':
+        proc.terminate.side_effect = missing
+    with mock.patch.object(base.subprocess, 'Popen', return_value=proc), \
+            mock.patch.object(base.time, 'sleep'), \
+            mock.patch.object(base.os, 'getpgid', return_value=123) as getpgid, \
+            mock.patch.object(base.os, 'killpg') as killpg:
+        if stage == 'getpgid':
+            getpgid.side_effect = missing
+        elif stage == 'killpg':
+            killpg.side_effect = missing
+        test = _Test(['test'])
+        test.timeout = 1
+        test.run()
+        assert test.result.result == status.TIMEOUT
+        assert 'exceeded timeout' in test.result.out
+        assert proc.communicate.call_count == 2
